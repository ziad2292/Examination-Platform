NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Server-only. Required for Super Admin Auth user management; never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
BOOTSTRAP_SUPERADMIN_ENABLED=false
BOOTSTRAP_SUPERADMIN_FULL_NAME=replace-with-production-admin-name
BOOTSTRAP_SUPERADMIN_EMAIL=replace-with-production-admin-email
BOOTSTRAP_SUPERADMIN_PASSWORD=replace-with-a-strong-one-time-password
BOOTSTRAP_SUPERADMIN_ROTATE_PASSWORD=false
BOOTSTRAP_SUPERADMIN_ALLOW_PROMOTION=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Africa/Cairo
